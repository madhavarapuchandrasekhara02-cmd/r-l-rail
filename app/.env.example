# Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/roots_and_leaves

# Razorpay Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Delhivery One Configuration
DELHIVERY_API_TOKEN=your-delhivery-api-token
# Use https://staging-express.delhivery.com for testing, and https://track.delhivery.com for live production
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_ORIGIN_PINCODE=your-origin-pincode
DELHIVERY_PICKUP_LOCATION_NAME=your-pickup-location
DELHIVERY_CLIENT_NAME=your-client-name
DELHIVERY_WEBHOOK_SECRET=your-delhivery-webhook-secret

# Seller Details
SELLER_STATE=your-state

# SEO & Analytics Configuration
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code
NEXT_PUBLIC_BING_VERIFICATION=your-bing-verification-code
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
